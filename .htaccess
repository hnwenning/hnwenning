# .htaccess - Apache Server Configuration for Wenning Technology
# Security, Performance, and SEO optimization

# ========== Enable Mod Rewrite ==========
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /
</IfModule>

# ========== GZIP Compression ==========
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
    AddOutputFilterByType DEFLATE application/xml application/xml+rss
    AddEncoding gzip svg
</IfModule>

# ========== Browser Caching ==========
<IfModule mod_expires.c>
    ExpiresActive On
    
    # Images
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/gif "access plus 30 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/svg+xml "access plus 30 days"
    ExpiresByType image/x-icon "access plus 1 year"
    
    # CSS and JavaScript
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"
    
    # HTML and XML
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType text/xml "access plus 0 seconds"
    ExpiresByType application/xml "access plus 0 seconds"
    
    # Fonts
    ExpiresByType font/ttf "access plus 1 year"
    ExpiresByType font/otf "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    
    # Default
    ExpiresDefault "access plus 2 days"
</IfModule>

# ========== ETag Handling ==========
<IfModule mod_headers.c>
    FileETag MTime Size
</IfModule>

# ========== Security Headers ==========
<IfModule mod_headers.c>
    # Content Security Policy
    Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'none';"
    
    # X-Frame-Options (Clickjacking Protection)
    Header set X-Frame-Options "DENY"
    
    # X-Content-Type-Options (MIME Sniffing Protection)
    Header set X-Content-Type-Options "nosniff"
    
    # X-XSS-Protection (XSS Protection)
    Header set X-XSS-Protection "1; mode=block"
    
    # Referrer-Policy
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    
    # Feature-Policy / Permissions-Policy
    Header set Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()"
    
    # Strict-Transport-Security (HSTS) - Enable after ensuring HTTPS is working
    Header set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
</IfModule>

# ========== URL Rewriting ==========
<IfModule mod_rewrite.c>
    # Remove .html extension from URLs
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^([^\.]+)$ $1.html [NC, L]
    
    # Redirect HTTP to HTTPS (uncomment when ready)
    # RewriteCond %{HTTPS} off
    # RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
    
    # Redirect non-www to www (or vice versa - choose one)
    # RewriteCond %{HTTP_HOST} ^hnwenning.com [NC]
    # RewriteRule ^(.*)$ https://www.hnwenning.com/$1 [L,R=301]
    
    # Prevent access to hidden files and directories
    RewriteRule "^\." - [F]
</IfModule>

# ========== Directory Indexing ==========
# Disable directory browsing
<IfModule mod_autoindex.c>
    Options -Indexes
</IfModule>

# ========== MIME Types ==========
<IfModule mod_mime.c>
    AddType application/json .json
    AddType application/xml .xml
    AddType image/svg+xml .svg
    AddType font/ttf .ttf
    AddType font/otf .otf
    AddType font/woff .woff
    AddType font/woff2 .woff2
    AddEncoding gzip .gz
</IfModule>

# ========== File Access Control ==========
# Deny access to sensitive files
<FilesMatch "^\.(htaccess|htpasswd|env|config)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
</FilesMatch>

# Prevent access to backup files
<FilesMatch "\.(bak|backup|log|swp|tmp|temp)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
</FilesMatch>

# ========== Character Encoding ==========
AddDefaultCharset UTF-8

# ========== Timeout Settings ==========
Timeout 300

# ========== Custom Error Pages (Optional) ==========
# ErrorDocument 404 /404.html
# ErrorDocument 500 /500.html

# ========== Alternative Hostnames ==========
# If using alternative domains, ensure redirects are set up

