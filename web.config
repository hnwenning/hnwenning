<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <!-- IIS Configuration for Wenning Technology Website -->
    
    <!-- System WebServer Settings -->
    <system.webServer>
        
        <!-- ========== GZIP Compression ========== -->
        <urlCompression doStaticCompression="true" doDynamicCompression="true" />
        <httpCompression>
            <staticTypes>
                <add mimeType="text/html" enabled="true" />
                <add mimeType="text/plain" enabled="true" />
                <add mimeType="text/xml" enabled="true" />
                <add mimeType="text/css" enabled="true" />
                <add mimeType="application/javascript" enabled="true" />
                <add mimeType="application/json" enabled="true" />
                <add mimeType="image/svg+xml" enabled="true" />
            </staticTypes>
            <dynamicTypes>
                <add mimeType="text/html" enabled="true" />
                <add mimeType="application/json" enabled="true" />
            </dynamicTypes>
        </httpCompression>
        
        <!-- ========== Static Content ========== -->
        <staticContent>
            <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="30.00:00:00" setETag="true" />
            <mimeMap fileExtension=".json" mimeType="application/json" />
            <mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
            <mimeMap fileExtension=".woff" mimeType="application/x-font-woff" />
            <mimeMap fileExtension=".woff2" mimeType="application/font-woff2" />
            <mimeMap fileExtension=".ttf" mimeType="application/x-font-truetype" />
            <mimeMap fileExtension=".otf" mimeType="application/x-font-opentype" />
        </staticContent>
        
        <!-- ========== Security Headers ========== -->
        <httpProtocol>
            <customHeaders>
                <!-- Content Security Policy -->
                <add name="Content-Security-Policy" value="default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'none';" />
                
                <!-- X-Frame-Options (Clickjacking Protection) -->
                <add name="X-Frame-Options" value="DENY" />
                
                <!-- X-Content-Type-Options -->
                <add name="X-Content-Type-Options" value="nosniff" />
                
                <!-- X-XSS-Protection -->
                <add name="X-XSS-Protection" value="1; mode=block" />
                
                <!-- Referrer-Policy -->
                <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
                
                <!-- Strict-Transport-Security -->
                <add name="Strict-Transport-Security" value="max-age=31536000; includeSubDomains; preload" />
            </customHeaders>
        </httpProtocol>
        
        <!-- ========== URL Rewriting ========== -->
        <rewrite>
            <rules>
                <!-- Remove trailing slash -->
                <rule name="Remove trailing slash" stopProcessing="true">
                    <match url="(.*)/$" />
                    <conditions>
                        <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
                        <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
                    </conditions>
                    <action type="Redirect" url="{R:1}" redirectType="Permanent" />
                </rule>
                
                <!-- Add .html extension -->
                <rule name="Add .html extension" stopProcessing="true">
                    <match url="^([^\.]+)$" />
                    <conditions>
                        <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
                        <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
                        <add input="{REQUEST_FILENAME}.html" matchType="IsFile" />
                    </conditions>
                    <action type="Rewrite" url="{R:1}.html" />
                </rule>
                
                <!-- Redirect from non-www to www (uncomment to use) -->
                <!-- <rule name="Redirect to www" stopProcessing="true">
                    <match url="(.*)" />
                    <conditions>
                        <add input="{HTTP_HOST}" pattern="^hnwenning\.com$" />
                    </conditions>
                    <action type="Redirect" url="https://www.hnwenning.com/{R:1}" redirectType="Permanent" />
                </rule> -->
                
                <!-- Force HTTPS (uncomment when ready) -->
                <!-- <rule name="Force HTTPS" stopProcessing="true">
                    <match url="(.*)" />
                    <conditions>
                        <add input="{HTTPS}" pattern="^OFF$" />
                    </conditions>
                    <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
                </rule> -->
            </rules>
        </rewrite>
        
        <!-- ========== Directory Security ========== -->
        <directoryBrowse enabled="false" />
        
        <!-- ========== Deny Access to Sensitive Files ========== -->
        <security>
            <requestFiltering>
                <fileExtensions>
                    <add fileExtension=".htaccess" allowed="false" />
                    <add fileExtension=".env" allowed="false" />
                    <add fileExtension=".bak" allowed="false" />
                    <add fileExtension=".backup" allowed="false" />
                    <add fileExtension=".tmp" allowed="false" />
                    <add fileExtension=".log" allowed="false" />
                </fileExtensions>
                <hiddenSegments>
                    <add segment=".git" />
                    <add segment=".htaccess" />
                    <add segment=".env" />
                </hiddenSegments>
            </requestFiltering>
        </security>
        
        <!-- ========== Error Handling ========== -->
        <httpErrors>
            <remove statusCode="404" subStatusCode="-1" />
            <error statusCode="404" prefixLanguageFilePath="" path="/404.html" responseMode="ExecuteURL" />
            
            <remove statusCode="500" subStatusCode="-1" />
            <error statusCode="500" prefixLanguageFilePath="" path="/500.html" responseMode="ExecuteURL" />
        </httpErrors>
        
        <!-- ========== Modules ========== -->
        <modules>
            <!-- Remove unnecessary modules for performance -->
            <remove name="WebDAVModule" />
            <remove name="DirectoryListingModule" />
        </modules>
        
        <!-- ========== Request Handlers ========== -->
        <handlers>
            <remove name="WebDAV" />
            <add name="HTML" path="*.html" verb="GET,POST" modules="StaticFile" resourceType="File" requireAccess="Read" />
        </handlers>
        
        <!-- ========== Application Settings ========== -->
        <applicationSettings>
            <add key="webPages:Enabled" value="false" />
        </applicationSettings>
        
    </system.webServer>
    
    <!-- ========== App Settings ========== -->
    <appSettings>
        <add key="SiteTitle" value="Wenning Technology" />
        <add key="SiteUrl" value="https://hnwenning.com" />
        <add key="ContactEmail" value="support@hnwenning.com" />
    </appSettings>
    
</configuration>
